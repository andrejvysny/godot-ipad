{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.world-painter.invalid/live-v1/envelope.schema.json",
  "title": "WorldPainterLiveEnvelopeV1",
  "description": "DRAFT. Text message envelope after hello (INT-SPEC-1.1 §10.2). UTF-8 JSON, at most 65536 bytes; before authentication at most 8192 bytes. Per-type payload schemas are frozen in IP-05/IP-06. Unknown types fail the session; no Godot Variant/Object deserialization.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "protocol_version", "session_id", "stream_id", "message_id", "type", "payload"],
  "properties": {
    "protocol": {"const": "world-painter-live"},
    "protocol_version": {"const": 1},
    "session_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "stream_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "message_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "type": {
      "enum": [
        "hello", "hello_result", "resume", "resume_result",
        "blob_begin", "blob_end", "blob_abort",
        "snapshot_ack", "commit_ack", "preview_cancel", "resync_required",
        "assets_needed", "asset_status", "ping", "pong", "session_close", "error"
      ]
    },
    "payload": {"type": "object"}
  },
  "$defs": {
    "blob_begin_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transfer_id", "kind", "format", "total_bytes", "chunk_size", "chunk_count", "sha256"],
      "properties": {
        "transfer_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "kind": {"enum": ["snapshot", "commit", "preview"]},
        "format": {"enum": ["worldpoc-v4", "world-delta-v1"]},
        "operation_id": {"type": "string"},
        "base_revision": {"type": "integer", "minimum": 0},
        "base_authored_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "target_revision": {"type": "integer", "minimum": 0},
        "target_authored_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "preview_seq": {"type": "integer", "minimum": 0},
        "total_bytes": {"type": "integer", "minimum": 1, "maximum": 276824064, "$comment": "264 MiB snapshot cap; deltas <= 64 MiB checked semantically."},
        "chunk_size": {"type": "integer", "minimum": 1, "maximum": 262144},
        "chunk_count": {"type": "integer", "minimum": 1, "$comment": "Must equal ceil(total_bytes / chunk_size)."},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
