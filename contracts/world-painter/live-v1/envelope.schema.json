{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.world-painter.invalid/live-v1/envelope.schema.json",
  "title": "WorldPainterLiveEnvelopeV1",
  "description": "Text message envelope after hello (INT-SPEC-1.1 §10.2, ADR 0015). UTF-8 JSON, at most 65536 bytes; before authentication at most 8192 bytes. Unknown types or payload keys fail the session; no Godot Variant/Object deserialization. Strings <= 1024 chars, lists/maps <= 64 entries, integers 0..2^53 unless stated.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "protocol_version",
    "session_id",
    "stream_id",
    "message_id",
    "type",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "world-painter-live"
    },
    "protocol_version": {
      "const": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "stream_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "message_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "type": {
      "enum": [
        "hello",
        "hello_result",
        "resume",
        "resume_result",
        "blob_begin",
        "blob_end",
        "blob_abort",
        "snapshot_ack",
        "commit_ack",
        "preview_cancel",
        "resync_required",
        "assets_needed",
        "asset_status",
        "ping",
        "pong",
        "session_close",
        "error"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "blob_begin_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transfer_id",
        "kind",
        "format",
        "total_bytes",
        "chunk_size",
        "chunk_count",
        "sha256"
      ],
      "properties": {
        "transfer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "kind": {
          "enum": [
            "snapshot",
            "commit",
            "preview"
          ]
        },
        "format": {
          "enum": [
            "worldpoc-v4",
            "world-delta-v1"
          ]
        },
        "operation_id": {
          "type": "string"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "base_authored_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "target_revision": {
          "type": "integer",
          "minimum": 0
        },
        "target_authored_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "preview_seq": {
          "type": "integer",
          "minimum": 0
        },
        "total_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 276824064,
          "$comment": "264 MiB snapshot cap; deltas <= 64 MiB checked semantically."
        },
        "chunk_size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        },
        "chunk_count": {
          "type": "integer",
          "minimum": 1,
          "$comment": "Must equal ceil(total_bytes / chunk_size)."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "hello_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "protocol_versions",
        "auth",
        "app",
        "capabilities"
      ],
      "properties": {
        "role": {
          "enum": [
            "sender",
            "receiver"
          ]
        },
        "protocol_versions": {
          "type": "array",
          "items": {
            "type": "integer"
          },
          "maxItems": 64
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "maxProperties": 1,
          "properties": {
            "pairing_token": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "session_credential": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "app": {
          "type": "string",
          "maxLength": 1024
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 64
        }
      }
    },
    "hello_result_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "session_credential": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "limits": {
          "type": "object",
          "maxProperties": 64
        },
        "receiver": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "profile"
          ],
          "properties": {
            "profile": {
              "type": "string",
              "maxLength": 1024
            }
          }
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "resume_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "stream_id",
        "revision",
        "authored_hash"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "maxLength": 1024
        },
        "stream_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "authored_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "resume_result_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "revision",
        "authored_hash"
      ],
      "properties": {
        "mode": {
          "enum": [
            "continue",
            "snapshot"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "authored_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "blob_end_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transfer_id"
      ],
      "properties": {
        "transfer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        }
      }
    },
    "blob_abort_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transfer_id",
        "reason"
      ],
      "properties": {
        "transfer_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "reason": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "ack_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "world_id",
        "stream_id",
        "revision",
        "authored_hash",
        "visual_ready"
      ],
      "properties": {
        "world_id": {
          "type": "string",
          "maxLength": 1024
        },
        "stream_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "authored_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "visual_ready": {
          "type": "boolean"
        }
      }
    },
    "preview_cancel_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation_id"
      ],
      "properties": {
        "operation_id": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "resync_required_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 1024
        },
        "revision": {
          "type": "integer",
          "minimum": 0
        },
        "authored_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "assets_needed_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_ids"
      ],
      "properties": {
        "binding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^b[0-9a-f]{32}$"
          },
          "maxItems": 64
        }
      }
    },
    "asset_status_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ready",
        "unavailable"
      ],
      "properties": {
        "ready": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024
          },
          "maxItems": 64
        },
        "unavailable": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "string",
            "maxLength": 1024
          }
        }
      }
    },
    "ping_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonce"
      ],
      "properties": {
        "nonce": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "session_close_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason"
      ],
      "properties": {
        "reason": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "error_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 1024
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        }
      }
    }
  },
  "$comment": "Payload by type: hello, hello_result, resume, resume_result, blob_begin, blob_end, blob_abort, snapshot_ack/commit_ack (ack_payload), preview_cancel, resync_required, assets_needed, asset_status, ping/pong (ping_payload), session_close, error. blob_begin: snapshot -> format worldpoc-v4 and no operation fields; commit -> world-delta-v1 + operation_id, base_revision, base_authored_hash, target_revision, target_authored_hash; preview -> world-delta-v1 + operation_id, base_revision, preview_seq."
}
